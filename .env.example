SHOP=mitienda.myshopify.com
# App del Dev Dashboard: Client ID y Client secret (Configuración de la app)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Solo si usas una app heredada del admin con token fijo (deja vacío si no)
SHOPIFY_TOKEN=
API_VERSION=2026-07
# Impresora de red (cocina). Vacío = no se usa
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
# Impresora USB (caja): nombre exacto en Windows (PowerShell: Get-Printer | Select Name). Vacío = no se usa
PRINTER_USB=
POLL_SECONDS=15
PRINTED_TAG=comanda-impresa
# Pedidos contraentrega: usa (financial_status:paid OR financial_status:pending)
ORDER_FILTER=financial_status:paid
COPIES=1
NOTIFY=true
# Opcional: alerta sonora más fuerte (formato .wav)
SOUND_FILE=
# ej: SOUND_FILE=C:\comanda-agent\timbre.wav
SOUND_REPEAT=2
